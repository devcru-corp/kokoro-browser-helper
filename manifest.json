{
  "manifest_version": 3,
  "name": "React NodeJS Chrome Extension",
  "version": "1.0",
  "description": "A boilerplate Chrome Extension using React and NodeJS for building.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.bundle.js"
  },
  "permissions": []
}
